# Copy to .env and fill in locally. Never commit real values.

# Optional Gemini semantic reranking (off by default; heuristic fallback).
GEMINI_API_KEY=
NEESHOPS_ENABLE_LLM_RERANKER=false
NEESHOPS_LLM_PROVIDER=gemini
NEESHOPS_LLM_MODEL=gemini-3.7-flash
NEESHOPS_LLM_RERANK_LIMIT=30
NEESHOPS_LLM_MIN_CONSTRAINTS=2
NEESHOPS_LLM_TIMEOUT_SECONDS=5

# Optional semantic retrieval.
NEESHOPS_ENABLE_SEMANTIC_RETRIEVAL=false

# Paths (defaults shown; override if data lives elsewhere).
NEESHOPS_CATALOG_PATH=data/catalog.jsonl
NEESHOPS_PUBLIC_SET_PATH=data/public_set.jsonl

# Logging.
NEESHOPS_LOG_LEVEL=INFO
