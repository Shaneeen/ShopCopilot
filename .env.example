# Copy to .env and fill in locally. Never commit real values.

# --- Optional LLM provider (used only by neeshops.ranking.llm_reranker and
# clarification/paraphrasing if enabled — the system must run without these) ---
LLM_PROVIDER=anthropic          # anthropic | openai | none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Feature flags ---
NEESHOPS_ENABLE_LLM_RERANKER=false
NEESHOPS_ENABLE_SEMANTIC_RETRIEVAL=false

# --- Paths (defaults shown; override if your data lives elsewhere) ---
NEESHOPS_CATALOG_PATH=data/catalog.jsonl
NEESHOPS_PUBLIC_SET_PATH=data/public_set.jsonl

# --- Logging ---
NEESHOPS_LOG_LEVEL=INFO
